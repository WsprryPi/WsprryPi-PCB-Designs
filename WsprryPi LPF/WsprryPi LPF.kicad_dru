(version 1)

# Intentional edge-launch lands, limited to pads of J2/J3 on this board.
# Other copper retains the project-wide 0.50 mm board-edge clearance.
(rule "Adafruit 1865 edge-launch pads"
  (condition "(A.Type == 'Pad' && (A.memberOfFootprint('J2') || A.memberOfFootprint('J3'))) || (B.Type == 'Pad' && (B.memberOfFootprint('J2') || B.memberOfFootprint('J3')))")
  (constraint edge_clearance (min 0mm)))
