				(bold yes)
			)
		)
	)
	(gr_text "FABRICATION REMINDER - SEVEN FILLED/CAPPED THROUGH VIAS\n\nEpoxy-fill, planarize, and copper-cap ONLY the five\nGND vias in ${5d9a238b-5df3-49c9-8cd2-6779ec770f50:REFERENCE} exposed pad 17 and the two DECL\nvias centered on ${4c44b8c8-c02e-4312-bb71-18f32a7e0676:REFERENCE} pad 1 and ${f595eb02-e28f-4346-a653-39831e8d909c:REFERENCE} pad 1.\nAll seven: 0.60 mm copper / 0.25 mm drill, F.Cu-B.Cu.\nKeep F-side caps solderable; tent B-side pads.\nUse through vias only; no blind, buried, or microvias.\nOther vias retain their specified treatment.\nLeave component through-holes open.\n\nMove the ADL5904 Detector group with its selected\nvias. Regenerate the selective-via drawing after\nboard changes. Confirm the selective two-layer\nprocess with the fabricator before production."
		(at 92.94 73.44 0)
		(layer "F.Fab")
		(uuid "ad9f2696-1d82-43e2-83ca-304e9a8b5ed7")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
