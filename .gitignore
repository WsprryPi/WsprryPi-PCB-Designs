# KiCad local settings, locks, and caches
*.kicad_prl
*.lck
fp-info-cache
*.3dshapes/cache/

# KiCad automatic backups, autosaves, and local history
*-backups/
.history/
_autosave-*
~*.kicad_sch
~*.kicad_pcb
*.kicad_sch-bak
*.kicad_pcb-bak
*.sch-bak
*.brd-bak
*.bak

# Regenerable exports: write Gerbers, drill files, BOMs, placement files,
# reports, and fabrication ZIPs into these directories in each project.
production/
fabrication/
generated/

# macOS and Windows filesystem metadata
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Desktop.ini

# Editor state and temporary files
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.code-workspace
*.swp
*.swo
*~
*.tmp
*.orig
*.log

# Local assistant/tool state; root agent instructions remain trackable
.agents/
.claude/
.codex/

# Keep design sources and reference assets trackable. In particular, do not
# blanket-ignore .kicad_sym, .kicad_mod, .step, .stp, .wrl, .csv, .xml, .pdf,
# .zip, or legacy *-cache.lib / *-rescue.lib libraries.
